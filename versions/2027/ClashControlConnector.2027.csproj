<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ClashControl Connector — Revit 2027 build
    =========================================
    Revit 2027 continues the .NET 8 runtime that started with Revit 2025.
    All shared source lives in ..\..\src and is pulled in via the Compile
    globs below so every per-version project builds from exactly the same
    code. Only this file (and the Revit reference paths) differs per year.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClashControlConnector</RootNamespace>
    <AssemblyName>ClashControlConnector</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    Local builds (default) reference RevitAPI from the real Revit install.
    CI builds pass -p:UseStubRevitApi=true to swap in Nice3point's stub
    NuGet packages so the build needs no Revit install at all.

    Note: at the time of writing the Nice3point stub package for Revit
    2027 may not yet exist on NuGet. The build-installer GitHub Action
    therefore tolerates failures of the 2027 step (see
    .github/workflows/build-installer.yml). Once a 2027 stub is
    published this should start passing automatically.
  -->
  <ItemGroup Condition="'$(UseStubRevitApi)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseStubRevitApi)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="2027.0.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.0" />
  </ItemGroup>

  <!-- Shared source files live in src/. Exclude any bin/obj in the shared dir. -->
  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="..\..\src\**\*.cs" Exclude="..\..\src\**\bin\**;..\..\src\**\obj\**" />
    <EmbeddedResource Include="..\..\src\Resources\icon.png">
      <Link>Resources\icon.png</Link>
      <LogicalName>ClashControlConnector.Resources.icon.png</LogicalName>
    </EmbeddedResource>
    <None Include="..\..\src\ClashControlConnector.addin">
      <Link>ClashControlConnector.addin</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
